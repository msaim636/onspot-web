# ==============================================
# Backend Serverless API Keys (Keep private in Vercel settings)
# ==============================================

# Google Gemini API
GEMINI_API_KEY=

# Google OAuth Credentials (Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Resend Email Service
RESEND_API_KEY=

# Fallback Notification Email
NOTIFICATION_EMAIL=

# ==============================================
# Frontend Environment Variables (Vite Client-side)
# ==============================================
VITE_APP_NAME="OnSpot"
VITE_APP_TAGLINE="AI-Powered Social Media Manager"
VITE_API_BASE_URL="/api"
